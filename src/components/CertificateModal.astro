<div class="certificate-modal" id="certificate-modal" aria-hidden="true">

	<div class="certificate-modal-backdrop"></div>

	<div class="certificate-modal-content">

		<button
			class="certificate-modal-close"
			type="button"
			aria-label="Zamknij podgląd certyfikatu"
	>
			×
		</button>

		<img
			class="certificate-modal-image"
			src=""
			alt=""
		/>

	</div>

</div>


<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {

		const modal =
			document.querySelector('#certificate-modal');

		const modalImage =
			document.querySelector('.certificate-modal-image');

		const closeButton =
			document.querySelector('.certificate-modal-close');

		const backdrop =
			document.querySelector('.certificate-modal-backdrop');


		if (
			!modal ||
			!modalImage ||
			!closeButton ||
			!backdrop
		) {
			return;
		}


		const openModal = (image, title) => {

			modalImage.src = image;

			modalImage.alt =
				`Certyfikat ${title}`;

			modal.classList.add('is-open');

			modal.setAttribute(
				'aria-hidden',
				'false'
			);

			document.body.style.overflow =
				'hidden';

		};


		const closeModal = () => {

			modal.classList.remove('is-open');

			modal.setAttribute(
				'aria-hidden',
				'true'
			);

			document.body.style.overflow =
				'';

		};


		document.addEventListener(
			'click',
			(event) => {

				const target = event.target;

				if (!(target instanceof Element)) {
					return;
				}


				const imageButton =
					target.closest(
						'.certificate-image-button'
					);


				if (!imageButton) {
					return;
				}


				const image =
					imageButton.getAttribute(
						'data-certificate-image'
					);

				const title =
					imageButton.getAttribute(
						'data-certificate-title'
					);


				if (!image || !title) {
					return;
				}


				openModal(
					image,
					title
				);

			}
		);


		closeButton.addEventListener(
			'click',
			closeModal
		);


		backdrop.addEventListener(
			'click',
			closeModal
		);


		document.addEventListener(
			'keydown',
			(event) => {

				if (event.key === 'Escape') {
					closeModal();
				}

			}
		);

	});
</script>


<style>

	.certificate-modal {
		position: fixed;

		inset: 0;

		z-index: 1000;

		display: flex;

		align-items: center;
		justify-content: center;

		padding: 30px;

		opacity: 0;

		visibility: hidden;

		pointer-events: none;

		transition:
			opacity 0.25s ease,
			visibility 0.25s ease;
	}


	.certificate-modal.is-open {
		opacity: 1;

		visibility: visible;

		pointer-events: auto;
	}


	.certificate-modal-backdrop {
		position: absolute;

		inset: 0;

		background:
			rgba(2, 6, 12, 0.92);

		backdrop-filter:
			blur(8px);
	}


	.certificate-modal-content {
		position: relative;

		z-index: 1;

		display: flex;

		align-items: center;
		justify-content: center;

		max-width: 95vw;
		max-height: 92vh;
	}


	.certificate-modal-image {
		display: block;

		max-width: 95vw;
		max-height: 92vh;

		width: auto;
		height: auto;

		object-fit: contain;

		border-radius: 10px;

		box-shadow:
			0 30px 100px
			rgba(0, 0, 0, 0.65);
	}


	.certificate-modal-close {
		position: absolute;

		top: -18px;
		right: -18px;

		z-index: 2;

		width: 42px;
		height: 42px;

		display: flex;

		align-items: center;
		justify-content: center;

		border: 1px solid #334155;

		border-radius: 50%;

		background: #0f172a;

		color: white;

		font-size: 1.6rem;

		cursor: pointer;
	}


	.certificate-modal-close:hover {
		background: #1e293b;
	}


	@media (max-width: 600px) {

		.certificate-modal {
			padding: 14px;
		}


		.certificate-modal-content {
			max-width: 96vw;
			max-height: 92vh;
		}


		.certificate-modal-image {
			max-width: 96vw;
			max-height: 88vh;

			border-radius: 7px;
		}


		.certificate-modal-close {
			top: 10px;
			right: 10px;

			width: 38px;
			height: 38px;

			background:
				rgba(15, 23, 42, 0.92);
		}

	}

</style>