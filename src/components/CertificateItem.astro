---
interface Props {
	title: string;
	organization: string;
	year: number;
	description: string;
	image: string;
	result?: string;
	trainer?: string;
}

const {
	title,
	organization,
	year,
	description,
	image,
	result,
	trainer,
} = Astro.props;
---

<article class="certificate-item">

	<button
		class="certificate-header"
		type="button"
		aria-expanded="false"
	>
		<div class="certificate-main">

			<div class="certificate-icon">
				✓
			</div>

			<div class="certificate-title">
				<h3>{title}</h3>

				<p>
					{organization}
					<span>•</span>
					{year}
				</p>
			</div>

		</div>

		<span class="toggle-icon">+</span>
	</button>


	<div class="certificate-details">

		<div class="certificate-details-inner">

			<div class="certificate-preview">
				<button
					class="certificate-image-button"
					type="button"
					data-certificate-image={image}
					data-certificate-title={title}
					aria-label={`Powiększ certyfikat ${title}`}
				>
					<img
						src={image}
						alt={`Certyfikat ${title}`}
						loading="lazy"
					/>
				</button>
			</div>


			<div class="certificate-description">

				<p>{description}</p>


				{
					trainer && (
						<div class="certificate-extra">
							<span>Prowadzący</span>
							<strong>{trainer}</strong>
						</div>
					)
				}


				{
					result && (
						<div class="certificate-extra">
							<span>Wynik egzaminu</span>
							<strong>{result}</strong>
						</div>
					)
				}

			</div>

		</div>

	</div>

</article>




<style>

	.certificate-item {
		border-top: 1px solid #1f2937;
	}


	.certificate-item:last-child {
		border-bottom: 1px solid #1f2937;
	}


	.certificate-header {
		width: 100%;

		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 30px;

		padding: 26px 4px;

		border: 0;

		background: transparent;

		text-align: left;

		cursor: pointer;
	}


	.certificate-main {
		display: flex;
		align-items: center;

		gap: 18px;

		min-width: 0;
	}


	.certificate-icon {
		width: 38px;
		height: 38px;

		flex-shrink: 0;

		display: flex;
		align-items: center;
		justify-content: center;

		border: 1px solid #263244;
		border-radius: 9px;

		background: #0d131d;

		color: #60a5fa;

		font-size: 0.9rem;
		font-weight: 800;
	}


	.certificate-title {
		min-width: 0;
	}


	.certificate-title h3 {
		margin: 0;

		color: #e2e8f0;

		font-size: 1rem;
		font-weight: 600;

		line-height: 1.4;
	}


	.certificate-title p {
		margin: 6px 0 0;

		color: #64748b;

		font-size: 0.78rem;
	}


	.certificate-title p span {
		margin: 0 7px;

		color: #334155;
	}


	.toggle-icon {
		width: 36px;
		height: 36px;

		flex-shrink: 0;

		display: flex;
		align-items: center;
		justify-content: center;

		border: 1px solid #263244;
		border-radius: 8px;

		color: #94a3b8;

		font-size: 1.2rem;

		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}


	.certificate-header:hover .toggle-icon {
		color: white;

		border-color: #3b82f6;

		background: #0f172a;
	}


	.certificate-details {
		display: grid;

		grid-template-rows: 0fr;

		transition:
			grid-template-rows 0.35s ease;
	}


	.certificate-item.is-open .certificate-details {
		grid-template-rows: 1fr;
	}


	.certificate-details-inner {
		overflow: hidden;

		display: grid;

		grid-template-columns: 230px 1fr;

		gap: 36px;
	}


	.certificate-item.is-open
	.certificate-details-inner {
		padding: 5px 4px 32px;
	}


	.certificate-preview {
		min-width: 0;
	}


	.certificate-image-button {
		width: 100%;

		padding: 0;

		border: 1px solid #263244;
		border-radius: 10px;

		background: #0b0f15;

		overflow: hidden;

		cursor: pointer;
	}


	.certificate-image-button img {
		width: 100%;

		display: block;

		aspect-ratio: 4 / 3;

		object-fit: cover;

		transition:
			transform 0.3s ease;
	}


	.certificate-image-button:hover img {
		transform: scale(1.03);
	}


	.certificate-description {
		display: flex;
		flex-direction: column;

		justify-content: center;
	}


	.certificate-description > p {
		margin: 0;

		max-width: 760px;

		color: #94a3b8;

		font-size: 0.92rem;
		line-height: 1.75;
	}


	.certificate-extra {
		display: flex;

		gap: 10px;

		margin-top: 18px;

		font-size: 0.8rem;
	}


	.certificate-extra span {
		color: #64748b;
	}


	.certificate-extra strong {
		color: #cbd5e1;
	}


	@media (max-width: 700px) {

		.certificate-header {
			padding: 22px 0;

			gap: 16px;
		}


		.certificate-main {
			align-items: flex-start;

			gap: 13px;
		}


		.certificate-icon {
			width: 34px;
			height: 34px;
		}


		.certificate-title h3 {
			font-size: 0.94rem;
		}


		.certificate-title p {
			font-size: 0.72rem;
		}


		.certificate-details-inner {
			grid-template-columns: 1fr;

			gap: 22px;
		}


		.certificate-item.is-open
		.certificate-details-inner {
			padding: 2px 0 28px;
		}


		.certificate-preview {
			max-width: 340px;
		}


		.certificate-description > p {
			font-size: 0.88rem;
		}

	}

</style>