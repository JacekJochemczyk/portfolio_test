<header class="header">
	<div class="header-inner">

		<a class="brand" href="/">
			<div class="logo">
				<img
					src="/profile.jpg"
					alt="Jacek Jochemczyk"
				/>
			</div>

			<div class="brand-text">
				<strong>Jacek Jochemczyk</strong>
				<p>IT Support • Cybersecurity • Development</p>
			</div>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-label="Otwórz menu"
			aria-expanded="false"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<nav class="nav">
			<a href="#o-mnie">O mnie</a>
			<a href="#projekty">Projekty</a>
			<a href="#certyfikaty">Certyfikaty</a>
			<a href="#kontakt">Kontakt</a>
		</nav>

	</div>
</header>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {

		const button =
			document.querySelector('.menu-toggle');

		const nav =
			document.querySelector('.nav');


		if (!button || !nav) {
			return;
		}


		const closeMenu = () => {

			nav.classList.remove('open');

			button.setAttribute(
				'aria-expanded',
				'false'
			);

		};


		button.addEventListener('click', () => {

			const isOpen =
				nav.classList.toggle('open');


			button.setAttribute(
				'aria-expanded',
				String(isOpen)
			);

		});


		nav.addEventListener('click', (event) => {

			const target = event.target;


			if (!(target instanceof Element)) {
				return;
			}


			const link =
				target.closest('a');


			if (!link) {
				return;
			}


			closeMenu();

		});


		window.addEventListener(
			'scroll',
			() => {

				if (nav.classList.contains('open')) {
					closeMenu();
				}

			},
			{
				passive: true
			}
		);

	});
</script>

