<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {

		const button =
			document.querySelector('.phone-toggle');

		const phone =
			document.querySelector('.phone-number');


		if (!button || !phone) {
			return;
		}


		button.addEventListener('click', () => {

			const isVisible =
				!phone.hasAttribute('hidden');


			if (isVisible) {

				phone.setAttribute(
					'hidden',
					''
				);

				button.textContent =
					'Pokaż numer';

				button.setAttribute(
					'aria-expanded',
					'false'
				);

			} else {

				phone.removeAttribute(
					'hidden'
				);

				button.textContent =
					'Ukryj numer';

				button.setAttribute(
					'aria-expanded',
					'true'
				);

			}

		});

	});
</script>


